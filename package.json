{
  "name": "langgraph-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Typed planner-executor-reviewer orchestration with LangGraph",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/openai": "1.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
